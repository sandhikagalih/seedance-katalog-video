# Salin menjadi .env. Isi key hanya di file .env pada server.
ARK_API_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set true bila diakses melalui HTTPS (termasuk reverse proxy).
SESSION_COOKIE_SECURE=false
# Isi kurs rupiah per 1 USD untuk laporan biaya, contoh: 16000.
KURS_USD_IDR=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_MODEL=dreamina-seedance-2-5-260628
VIDEO_DURATION=5
VIDEO_RESOLUTION=480p
PORT=3000
# Default hanya dapat diakses dari komputer ini. Untuk LAN: HOST=0.0.0.0
HOST=127.0.0.1
